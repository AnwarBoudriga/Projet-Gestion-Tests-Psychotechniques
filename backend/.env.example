PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://psytech:psytech@localhost:5432/psytech_pro

# JWT : générez une vraie valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-par-une-valeur-aleatoire-de-48-octets-minimum
JWT_EXPIRES_IN=8h

# Origines autorisées (Flutter web). Séparées par des virgules. Vide en dev = tout autoriser.
CORS_ORIGINS=

BCRYPT_ROUNDS=12
